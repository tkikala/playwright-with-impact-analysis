{
  "name": "playwright-impact-analysis",
  "version": "0.1.0",
  "description": "Deterministic Playwright test impact analysis from frontend runtime coverage.",
  "type": "module",
  "main": "src/cli.mjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkikala/playwright-with-impact-analysis.git"
  },
  "homepage": "https://tkikala.github.io/playwright-with-impact-analysis/",
  "bugs": {
    "url": "https://github.com/tkikala/playwright-with-impact-analysis/issues"
  },
  "files": [
    "action.yml",
    "src",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "bin": {
    "pw-impact": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./playwright": "./src/playwright/impact-fixture.mjs",
    "./playwright/collector": "./src/playwright/coverage-collector.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:integration": "node --test test/integration.test.mjs",
    "check": "node src/cli.mjs --help"
  },
  "keywords": [
    "playwright",
    "github-action",
    "test-impact-analysis",
    "coverage",
    "ci"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {}
}
